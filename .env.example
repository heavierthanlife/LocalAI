# ── Local_AI Production Environment Variables ──
# Copy to .env and fill in your values

# ── LLM Provider API Keys (FIX-016: OpenRouter + NVIDIA NIM are the active sources) ──
# At least one required. OpenRouter :free pool + NVIDIA NIM free tier.
OPENROUTER_API_KEY=sk-or-your-openrouter-key
NVIDIA_API_KEY=nvapi-your-nvidia-key

# Legacy providers — COMMENTED OUT (kept for reference; user consolidated on the two free sources)
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# ZHIPU_API_KEY=
# QWEN_API_KEY=
# SILICONFLOW_API_KEY=
# MIMO_API_KEY=

# ── Vision-Language Model (optional, for image description) ──
# FIX-016: VL connects to NVIDIA NIM (nemotron-3-nano-omni-30b-a3b-reasoning)
DASHSCOPE_API_KEY=

# ── Search API ──
BOCHA_API_KEY=sk-your-bocha-key

# ── Database ──
# Docker mode (DATABASE_URL, auto-injected):
# DATABASE_URL=postgresql://localai:password@postgres:5432/localai
# Local dev mode (PG_* vars, set these for IDE/PyCharm):
# PG_USER=postgres
# PG_PASSWORD=postgres
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=postgres
DB_PASSWORD=change-me-in-production

# ── Security ──
# APP_ENV=development | production. production 下必须设置 ADMIN_PIN 或 ADMIN_PASSWORD_HASH,
# 否则应用拒绝启动（fail-closed）；development 下缺省回退到 123456 并告警。
APP_ENV=development
FLASK_SECRET_KEY=change-me-to-a-random-64-char-string
WTF_CSRF_SECRET_KEY=change-me-to-another-random-string
# 管理员统一登录 PIN（admin/CEO/COO 共用）。生产环境必填，请勿使用默认值。
ADMIN_PIN=change-me-to-a-strong-pin

# ── Email / SMTP (optional, for notifications) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# ADMIN_EMAIL=

# ── App Config ──
LLM_TIMEOUT=120
AI_NAME=中联助手
# ENABLE_SCHEDULER=true

# ── Wiki ──
# WIKI_DIR=data/wiki
# WIKI_LLM_MODEL=deepseek-chat

# ── Agent Memory (MCP-based persistent memory for AI coding agents) ──
# AGENTMEMORY_URL=http://localhost:3111