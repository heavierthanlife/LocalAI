# ── Local_AI Production Environment Variables ──
# Copy to .env and fill in your values

# ── LLM Provider API Keys (at least one required) ──
DEEPSEEK_API_KEY=sk-your-deepseek-key
ZHIPU_API_KEY=
QWEN_API_KEY=
SILICONFLOW_API_KEY=

# ── Vision-Language Model (optional, for image description) ──
DASHSCOPE_API_KEY=

# ── Search API ──
BOCHA_API_KEY=sk-your-bocha-key

# ── Database ──
# Docker mode (DATABASE_URL, auto-injected):
# DATABASE_URL=postgresql://localai:password@postgres:5432/localai
# Local dev mode (PG_* vars, set these for IDE/PyCharm):
# PG_USER=postgres
# PG_PASSWORD=postgres
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=postgres
DB_PASSWORD=change-me-in-production

# ── Security ──
FLASK_SECRET_KEY=change-me-to-a-random-64-char-string
WTF_CSRF_SECRET_KEY=change-me-to-another-random-string
ADMIN_PIN=123456

# ── App Config ──
LLM_TIMEOUT=120
WORKERS=4
CREDIT_BROWSER_HEADLESS=true
